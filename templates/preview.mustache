{{!
    @template tool_gradesort/preview

    The order a grade category's contents are in now, beside the order they
    would be in after sorting.

    Context variables required for this template:
    * rows - array of before/after pairs; either side may be null
    * unchanged - true when the sort would make no difference

    Example context (json):
    {
        "unchanged": false,
        "rows": [
            {
                "current": {"name": "Quiz: Midterm", "typename": "Quiz", "iscategory": false},
                "after": {"name": "Essay 1", "typename": "Assignment", "iscategory": false}
            },
            {
                "current": {"name": "Essay 1", "typename": "Assignment", "iscategory": false},
                "after": {"name": "Quiz: Midterm", "typename": "Quiz", "iscategory": false}
            },
            {
                "current": {"name": "Group work", "typename": null, "iscategory": true},
                "after": {"name": "Group work", "typename": null, "iscategory": true}
            }
        ]
    }
}}
{{#unchanged}}
    <div class="alert alert-info" role="status">{{#str}}nothingtodo, tool_gradesort{{/str}}</div>
{{/unchanged}}
<div class="table-responsive">
    <table class="generaltable w-100">
        <caption class="sr-only">{{#str}}preview, tool_gradesort{{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}}columncurrent, tool_gradesort{{/str}}</th>
                <th scope="col">{{#str}}columnafter, tool_gradesort{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <td>
                        {{#current}}
                            {{#iscategory}}<strong>{{name}}</strong>{{/iscategory}}
                            {{^iscategory}}{{name}}{{/iscategory}}
                        {{/current}}
                    </td>
                    <td>
                        {{#after}}
                            {{#iscategory}}<strong>{{name}}</strong>{{/iscategory}}
                            {{^iscategory}}{{name}}{{/iscategory}}
                        {{/after}}
                    </td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
